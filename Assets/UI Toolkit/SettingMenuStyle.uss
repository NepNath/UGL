.header {
    font-size: 50px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/TASAExplorer-VariableFont_wght.ttf?fileID=12800000&guid=3d6e82f35781b4e4f8e500fb6ffebee8&type=3#TASAExplorer-VariableFont_wght");
    color: rgb(255, 255, 255);
}

.button {
    width: 200px;
    height: 60px;
    font-size: 30px;
    background-image: url("project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/medium/extra-long-pink-medium.png?fileID=2800000&guid=3458579a976f1fd469810e16fe8f2550&type=3#extra-long-pink-medium");
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/TASAExplorer-VariableFont_wght.ttf?fileID=12800000&guid=3d6e82f35781b4e4f8e500fb6ffebee8&type=3#TASAExplorer-VariableFont_wght");
}

.button:hover {
    scale: 1.1 1.1;
    background-color: rgb(255, 0, 0);
    rotate: 0;
}

.dropdown {
    color: rgb(0, 0, 0);
    font-size: 30px;
    background-image: url("project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Highlighted_Sprite/extra%20large/extra-long-purple-highlight-extra-large.png?fileID=2800000&guid=d7867fb5033ff544da453535f6063936&type=3#extra-long-purple-highlight-extra-large");
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/TASAExplorer-VariableFont_wght.ttf?fileID=12800000&guid=3d6e82f35781b4e4f8e500fb6ffebee8&type=3#TASAExplorer-VariableFont_wght");
    width: auto;
    height: 60px;
    -unity-text-align: upper-center;
    margin-left: 0;
    padding-left: 25px;
}
